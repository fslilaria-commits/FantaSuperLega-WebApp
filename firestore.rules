rules_version = '2';

// Modello dati, ruoli e motivazioni: docs/modello-dati.md
// Ruoli: Admin (dati di gioco), Presidente (la sua lega), Partecipante (la sua squadra), Visitatore.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Gli admin si nominano solo dalla console Firebase (collezione admins, documento = uid).
    // Possono cancellare tutti i dati di gioco (non gli admin né l'archivio): serve al pulsante "Inizia la stagione"
    // del pannello, che a ogni estate archivia le classifiche e riparte da zero (frontend/js/admin-stagione.js)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function league(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
    }

    function isPresident(leagueId) {
      return signedIn() && league(leagueId).presidentUid == request.auth.uid;
    }

    function isMember(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Scadenza (blocco delle formazioni) della giornata numero
    function scadenzaGiornata(numero) {
      return get(/databases/$(database)/documents/matchdays/$(string(numero))).data.lockAt;
    }

    // Tipo di gioco della lega: 'asta' (rose esclusive inserite dal Presidente; anche le leghe create prima che ci
    // fosse la scelta) o 'quotazioni' (prezzi fissi dell'admin, ognuno si fa la squadra, come il Fanta F1)
    function tipoLega(leagueId) {
      return league(leagueId).settings.get('tipo', 'asta');
    }

    // Elenco admin: ognuno può solo verificare se è admin; nessuna scrittura dall'app
    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, write: if false;
    }

    // Le leghe di ogni utente, per ritrovarle all'accesso; si aggiunge una lega solo entrandoci davvero
    match /users/{uid}/leagues/{leagueId} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['joinedAt'])
        && request.resource.data.joinedAt == request.time
        && existsAfter(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid));
      allow delete: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow update: if false;
    }

    // Listone: visibile a chi ha fatto l'accesso, aggiornato dagli admin dal pannello
    match /players/{playerId} {
      function validPlayer(d) {
        return d.keys().hasOnly(['name', 'team', 'teamId', 'role', 'number', 'birthYear', 'nationality', 'photo', 'active', 'updatedAt'])
          && isString(d.name, 80)
          && isString(d.team, 80)
          && d.role in ['P', 'S', 'C', 'O', 'L']
          && d.active is bool
          && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.matches('^https://www[.]legavolley[.]it/.*')));
      }

      allow read: if signedIn();
      allow create, update: if isAdmin() && validPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    // Informazioni sugli aggiornamenti (ultimo listone applicato, ecc.)
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Giornate e statistiche: gestite dagli admin
    match /matchdays/{n} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        && (resource.data.get('lockAt', null) == null
            || request.time < resource.data.lockAt
            || request.resource.data.get('lockAt', null) == resource.data.lockAt);

      match /stats/{playerId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // Correzioni manuali del tabellino: un documento per giornata, solo per gli admin
      match /correzioni/{docId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin()
          && docId == 'tabellino'
          && request.resource.data.keys().hasOnly(['righe', 'updatedAt', 'updatedBy'])
          && request.resource.data.righe is map
          && request.resource.data.righe.size() <= 300
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }
    }

    // Codici invito: si legge un codice alla volta, nessun elenco
    match /leagueCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['leagueId'])
        && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.presidentUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.code == code;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /leagues/{leagueId} {

      // A quotazioni il budget è quello di ogni squadra: un intero da 1 in su
      function validSettings(s) {
        return s.keys().hasOnly(['budget', 'mode', 'startMatchday', 'marketSuspended', 'tipo'])
          && (!('marketSuspended' in s) || s.marketSuspended is bool)
          && (!('tipo' in s) || s.tipo in ['asta', 'quotazioni'])
          && s.budget is number && s.budget >= 0 && s.budget <= 10000
          && (s.get('tipo', 'asta') == 'asta' || (s.budget is int && s.budget >= 1))
          && s.mode in ['classifica', 'scontri']
          && s.startMatchday is int && s.startMatchday >= 1;
      }

      function validLeague(d) {
        return d.keys().hasOnly(['name', 'code', 'presidentUid', 'settings', 'createdAt'])
          && isString(d.name, 60)
          && d.code is string && d.code.matches('^[0-9]{6}$')
          && validSettings(d.settings)
          && d.createdAt is timestamp;
      }

      allow read: if isMember(leagueId) || isPresident(leagueId) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.presidentUid == request.auth.uid
        && validLeague(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // Il Presidente cambia nome e impostazioni, non codice, presidenza, data di creazione o tipo di gioco.
      // Giornata di inizio e tipo di competizione si cambiano solo prima dell'inizio e prima del calendario delle sfide.
      // A quotazioni il budget non cambia mai: il Presidente ha una squadra come gli altri, e alzarlo per farsi la
      // sua e poi riabbassarlo gli lascerebbe una squadra fuori budget
      allow update: if isPresident(leagueId)
        && validLeague(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'settings'])
        && request.resource.data.settings.get('tipo', 'asta') == resource.data.settings.get('tipo', 'asta')
        && (resource.data.settings.get('tipo', 'asta') == 'asta'
            || request.resource.data.settings.budget == resource.data.settings.budget)
        && ((request.resource.data.settings.startMatchday == resource.data.settings.startMatchday
             && request.resource.data.settings.mode == resource.data.settings.mode)
            || (request.time < scadenzaGiornata(resource.data.settings.startMatchday)
                && !exists(/databases/$(database)/documents/leagues/$(leagueId)/schedule/main)));
      allow delete: if isAdmin();

      match /members/{uid} {
        function validMember(d) {
          return d.keys().hasOnly(['teamName', 'code', 'joinedAt'])
            && isString(d.teamName, 40)
            && d.joinedAt is timestamp;
        }

        allow read: if isMember(leagueId) || isAdmin();
        // Si entra solo con il codice giusto, e solo per sé stessi; negli scontri diretti non più dopo il calendario
        allow create: if signedIn()
          && uid == request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.joinedAt == request.time
          && request.resource.data.code == getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.code
          && !(getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.settings.mode == 'scontri'
               && exists(/databases/$(database)/documents/leagues/$(leagueId)/schedule/main));
        allow update: if signedIn()
          && uid == request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName']);
        allow delete: if isAdmin() || isPresident(leagueId) || (signedIn() && uid == request.auth.uid);
      }

      match /rosters/{uid} {
        // Durante l'asta la rosa si salva anche incompleta: al massimo 2 P, 4 S, 4 C, 2 O, 2 L
        function validRoster(d) {
          return d.keys().hasOnly(['P', 'S', 'C', 'O', 'L', 'all', 'prices', 'creditsLeft'])
            && d.P is list && d.P.size() <= 2
            && d.S is list && d.S.size() <= 4
            && d.C is list && d.C.size() <= 4
            && d.O is list && d.O.size() <= 2
            && d.L is list && d.L.size() <= 2
            && d.all is list && d.all.size() <= 14
            && d.all.toSet().size() == d.all.size()
            && d.all.toSet() == d.P.concat(d.S).concat(d.C).concat(d.O).concat(d.L).toSet()
            && d.prices is map && d.prices.keys().toSet() == d.all.toSet()
            && d.creditsLeft is number && d.creditsLeft >= 0;
        }

        // --- Leghe a quotazioni: la squadra se la fa ognuno, sempre completa, con i prezzi di meta/quotazioni ---

        // Chi arriva in un ruolo (non c'era in quel ruolo nella squadra salvata) deve avere una quotazione in quel
        // ruolo e pagarla. Si lavora per insiemi perché le regole hanno un limite di espressioni per richiesta
        function arriviGiusti(d, old, q, ruolo) {
          let arrivi = d[ruolo].toSet().difference(old[ruolo].toSet());
          let prezzi = q.get(ruolo, {});
          return prezzi.keys().toSet().hasAll(arrivi)
            && prezzi.diff(d.prices).changedKeys().intersection(arrivi).size() == 0;
        }

        // Chi resta tiene il prezzo pagato; chi arriva paga la quotazione del suo ruolo (un ruolo senza prezzi blocca
        // solo chi arriva in quel ruolo)
        function prezziGiusti(d, old) {
          let q = get(/databases/$(database)/documents/meta/quotazioni).data.get('prezzi', {});
          return old.prices.diff(d.prices).changedKeys().size() == 0
            && arriviGiusti(d, old, q, 'P') && arriviGiusti(d, old, q, 'S') && arriviGiusti(d, old, q, 'C')
            && arriviGiusti(d, old, q, 'O') && arriviGiusti(d, old, q, 'L');
        }

        // Le regole non hanno cicli: i 14 prezzi si sommano uno per uno
        function spesa(d) {
          let p = d.prices;
          return p[d.P[0]] + p[d.P[1]] + p[d.S[0]] + p[d.S[1]] + p[d.S[2]] + p[d.S[3]]
            + p[d.C[0]] + p[d.C[1]] + p[d.C[2]] + p[d.C[3]] + p[d.O[0]] + p[d.O[1]] + p[d.L[0]] + p[d.L[1]];
        }

        // Al massimo 5 cambi (giocatori che arrivano) per giornata, liberi nella prima giornata della squadra (dalla);
        // nella stessa giornata si sommano a quelli già fatti. La giornata non torna mai indietro: con le scadenze non
        // in ordine (giornata anticipata) alternare due giornate azzererebbe i cambi a ogni salvataggio
        function cambiGiusti(d, old, nuova) {
          return d.cambi is int && d.cambi <= 5
            && (nuova
              ? d.dalla == d.giornata && d.cambi == 0
              : d.dalla == old.dalla
                && d.giornata >= old.giornata
                && d.cambi == (d.giornata == old.dalla ? 0
                  : (old.giornata == d.giornata ? old.cambi : 0) + d.all.toSet().difference(old.all.toSet()).size()));
        }

        // giornata: la prossima da schierare (dopo la scadenza della precedente, prima della sua). Nello stesso
        // salvataggio va scritta la formazione di quella giornata, che per i punti è la squadra di quel momento.
        // all: i 14 nell'ordine dei ruoli (P, S, C, O, L), senza ripetizioni
        function validSquadra(d, old, nuova) {
          let n = d.giornata;
          return d.keys().hasOnly(['P', 'S', 'C', 'O', 'L', 'all', 'prices', 'creditsLeft', 'giornata', 'dalla', 'cambi'])
            && d.P.size() == 2 && d.S.size() == 4 && d.C.size() == 4 && d.O.size() == 2 && d.L.size() == 2
            && d.all == d.P.concat(d.S).concat(d.C).concat(d.O).concat(d.L)
            && d.all.toSet().size() == 14
            && d.prices.keys().toSet() == d.all.toSet()
            && n is int
            && request.time < scadenzaGiornata(n)
            && (n == 1 || request.time >= scadenzaGiornata(n - 1))
            && prezziGiusti(d, old)
            && d.creditsLeft == league(leagueId).settings.budget - spesa(d)
            && d.creditsLeft >= 0
            && cambiGiusti(d, old, nuova)
            && getAfter(/databases/$(database)/documents/leagues/$(leagueId)/lineups/$(string(n) + '_' + request.auth.uid)).data.savedAt == request.time;
        }

        allow read: if isMember(leagueId) || isAdmin();
        // Asta: le rose le inserisce il Presidente
        allow create, update: if isPresident(leagueId)
          && tipoLega(leagueId) == 'asta'
          && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid))
          && validRoster(request.resource.data);
        // Quotazioni: ognuno la propria
        allow create: if signedIn() && uid == request.auth.uid
          && isMember(leagueId)
          && tipoLega(leagueId) == 'quotazioni'
          && validSquadra(request.resource.data, {'P': [], 'S': [], 'C': [], 'O': [], 'L': [], 'prices': {}}, true);
        allow update: if signedIn() && uid == request.auth.uid
          && isMember(leagueId)
          && tipoLega(leagueId) == 'quotazioni'
          && validSquadra(request.resource.data, resource.data, false);
        // A quotazioni il Presidente non cancella le squadre: rifacendo la propria azzererebbe i cambi, e quelle degli
        // altri perderebbero i prezzi pagati
        allow delete: if isAdmin() || (isPresident(leagueId) && tipoLega(leagueId) == 'asta');
      }

      match /lineups/{lineupId} {
        // La rosa dopo il salvataggio: a quotazioni squadra e formazione si salvano insieme
        function roster(uid) {
          return getAfter(/databases/$(database)/documents/leagues/$(leagueId)/rosters/$(uid)).data;
        }

        function validLineup(d) {
          let s = d.starters;
          let r = roster(request.auth.uid);
          let starters = [s.P, s.S1, s.S2, s.C1, s.C2, s.O, s.L];
          return d.keys().hasOnly(['uid', 'matchday', 'starters', 'bench', 'captain', 'savedAt'])
            && d.savedAt == request.time
            && d.uid == request.auth.uid
            && d.matchday is int
            && lineupId == string(d.matchday) + '_' + request.auth.uid
            && s.keys().hasOnly(['P', 'S1', 'S2', 'C1', 'C2', 'O', 'L'])
            && s.keys().hasAll(['P', 'S1', 'S2', 'C1', 'C2', 'O', 'L'])
            && s.P in r.P
            && s.S1 in r.S && s.S2 in r.S
            && s.C1 in r.C && s.C2 in r.C
            && s.O in r.O
            && s.L in r.L
            && d.bench is list && d.bench.size() == 7
            && d.bench.hasOnly(r.all)
            && starters.concat(d.bench).toSet().size() == 14
            && d.captain in starters;
        }

        // La propria formazione sempre; quelle degli altri solo dopo la scadenza; gli admin per calcolare i punteggi
        allow read: if isAdmin() || (isMember(leagueId)
          && ((resource == null && lineupId.matches('^[0-9]+_' + request.auth.uid + '$'))
              || (resource != null
                  && (resource.data.uid == request.auth.uid || request.time >= scadenzaGiornata(resource.data.matchday)))));
        allow create, update: if isMember(leagueId)
          && validLineup(request.resource.data)
          && request.time < scadenzaGiornata(request.resource.data.matchday);
        allow delete: if isAdmin();
      }

      // Calendario degli scontri diretti: lo genera il Presidente prima della giornata di inizio,
      // oppure un admin (anche dopo, se il Presidente se ne è dimenticato)
      match /schedule/{docId} {
        function validSchedule(d) {
          return docId == 'main'
            && d.keys().hasOnly(['teams', 'rounds', 'createdAt', 'createdBy'])
            && d.teams is list && d.teams.size() <= 60
            && d.rounds is map && d.rounds.size() <= 40;
        }

        allow read: if isMember(leagueId) || isAdmin();
        allow create: if validSchedule(request.resource.data)
          && ((isPresident(leagueId) && request.time < scadenzaGiornata(league(leagueId).settings.startMatchday))
              || isAdmin());
        allow update: if isAdmin() && validSchedule(request.resource.data);
        allow delete: if isAdmin();
      }

      // --- Mercato (Modalità Leghe FantaLVF). Le assegnazioni le applica il Presidente con un clic ---

      function rosaDi(uid) {
        return get(/databases/$(database)/documents/leagues/$(leagueId)/rosters/$(uid)).data;
      }

      // Finestra per la giornata numero: dopo l'inizio della giornata prima, prima della sua scadenza,
      // mercato non sospeso dal Presidente (l'app apre il mercato solo a giornata precedente finita).
      // Offerte e scambi ci sono solo nelle leghe ad asta: a quotazioni ognuno cambia da sé la propria squadra
      function finestra(numero, fino) {
        return tipoLega(leagueId) == 'asta'
          && !league(leagueId).settings.get('marketSuspended', false)
          && request.time < fino
          && (numero == 1 || request.time >= scadenzaGiornata(numero - 1));
      }

      // Offerte segrete per gli svincolati: nessuno legge quelle degli altri prima della chiusura
      match /markets/{n}/offers/{offerId} {
        function chiusuraOfferte() {
          return scadenzaGiornata(int(n)) - duration.value(3, 'h');
        }

        function validOffer(d) {
          let rosa = rosaDi(d.uid);
          return d.keys().hasOnly(['uid', 'playerIn', 'playerOut', 'role', 'extra', 'status', 'createdAt', 'updatedAt'])
            && d.role in ['P', 'S', 'C', 'O', 'L']
            && d.extra is int && d.extra >= 0
            && d.playerOut in rosa[d.role]
            && !(d.playerIn in rosa.all);
        }

        allow read: if (signedIn() && resource.data.uid == request.auth.uid)
          || ((isPresident(leagueId) || isAdmin()) && request.time >= chiusuraOfferte());
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && offerId == request.auth.uid + '_' + request.resource.data.playerIn
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && validOffer(request.resource.data)
          && finestra(int(n), chiusuraOfferte());
        allow update: if (
            // chi ha fatto l'offerta la modifica, la ritira o la rifà finché le offerte sono aperte
            signedIn() && resource.data.uid == request.auth.uid && resource.data.status in ['active', 'withdrawn']
            && request.resource.data.updatedAt == request.time
            && finestra(int(n), chiusuraOfferte())
            && ((request.resource.data.status == 'active'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerOut', 'extra', 'status', 'updatedAt'])
                 && validOffer(request.resource.data))
              || (request.resource.data.status == 'withdrawn'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])))
          ) || (
            // il Presidente segna l'esito dopo la chiusura
            isPresident(leagueId) && request.time >= chiusuraOfferte()
            && request.resource.data.updatedAt == request.time
            && resource.data.status == 'active'
            && request.resource.data.status in ['won', 'lost']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'motivo'])
          );
        allow delete: if isAdmin();
      }

      // Scambi tra squadre: li vedono solo le due squadre (e Presidente e admin)
      match /trades/{tradeId} {
        function validTrade(d) {
          return d.keys().hasOnly(['from', 'to', 'give', 'take', 'role', 'extra', 'status', 'matchday', 'createdAt', 'updatedAt', 'counterOf'])
            && d.from != d.to
            && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(d.to))
            && d.role in ['P', 'S', 'C', 'O', 'L']
            && d.give in rosaDi(d.from)[d.role]
            && d.take in rosaDi(d.to)[d.role]
            && d.extra is int && d.extra >= 0
            && d.matchday is int;
        }

        allow read: if isPresident(leagueId) || isAdmin()
          || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
        allow create: if isMember(leagueId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.status == 'proposed'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && validTrade(request.resource.data)
          && finestra(request.resource.data.matchday, scadenzaGiornata(request.resource.data.matchday));
        allow update: if request.resource.data.updatedAt == request.time && ((
            signedIn() && resource.data.from == request.auth.uid && resource.data.status == 'proposed'
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            // chi riceve accetta (a mercato aperto), rifiuta o rilancia
            signedIn() && resource.data.to == request.auth.uid && resource.data.status == 'proposed'
            && request.resource.data.status in ['accepted', 'refused', 'countered']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && (request.resource.data.status != 'accepted'
                || finestra(resource.data.matchday, scadenzaGiornata(resource.data.matchday)))
          ) || (
            isPresident(leagueId) && resource.data.status == 'accepted'
            && request.resource.data.status in ['executed', 'void']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'motivo'])
          ));
        allow delete: if isAdmin();
      }

      // Registro dei movimenti: visibile a tutta la lega, lo scrive il Presidente quando applica il mercato
      match /transfers/{transferId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isPresident(leagueId)
          && tipoLega(leagueId) == 'asta'
          && request.resource.data.keys().hasOnly(['tipo', 'uid', 'playerIn', 'playerOut', 'valore', 'extra', 'matchday', 'at'])
          && request.resource.data.tipo in ['svincolato', 'scambio']
          && request.resource.data.uid is string
          && request.resource.data.playerIn is string
          && request.resource.data.playerOut is string
          && request.resource.data.playerIn != request.resource.data.playerOut
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Punteggi e classifica: li calcolano gli admin a partire dai tabellini ufficiali
      match /scores/{scoreId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isAdmin();
      }

      match /standings/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Archivio delle stagioni finite: la classifica finale di ogni lega, salvata dal pulsante "Inizia la stagione".
    // La vede solo chi era nella lega; resta anche quando i dati della stagione vengono cancellati
    match /archivio/{docId} {
      function validArchivio(d) {
        return d.keys().hasOnly(['anno', 'stagione', 'lega', 'modalita', 'tipo', 'uids', 'classifica', 'archiviatoAt', 'archiviatoBy'])
          && d.anno is int
          && isString(d.stagione, 10)
          && isString(d.lega, 60)
          && d.modalita in ['classifica', 'scontri']
          && (!('tipo' in d) || d.tipo in ['asta', 'quotazioni'])
          && d.uids is list && d.uids.size() <= 60
          && d.classifica is list && d.classifica.size() <= 60
          && d.archiviatoAt == request.time
          && d.archiviatoBy == request.auth.uid;
      }

      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.uids);
      allow create, update: if isAdmin() && validArchivio(request.resource.data);
      allow delete: if false;
    }
  }
}
