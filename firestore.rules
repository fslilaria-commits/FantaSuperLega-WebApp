rules_version = '2';

// Modello dati, ruoli e motivazioni: docs/modello-dati.md
// Ruoli: Admin (dati di gioco), Presidente (la sua lega), Partecipante (la sua squadra), Visitatore.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Gli admin si nominano solo dalla console Firebase (collezione admins, documento = uid)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function league(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
    }

    function isPresident(leagueId) {
      return signedIn() && league(leagueId).presidentUid == request.auth.uid;
    }

    function isMember(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }

    function isString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // Elenco admin: ognuno può solo verificare se è admin; nessuna scrittura dall'app
    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, write: if false;
    }

    // Le leghe di ogni utente, per ritrovarle all'accesso; si aggiunge una lega solo entrandoci davvero
    match /users/{uid}/leagues/{leagueId} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['joinedAt'])
        && existsAfter(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid));
      allow delete: if signedIn() && uid == request.auth.uid;
      allow update: if false;
    }

    // Listone: visibile a chi ha fatto l'accesso, aggiornato dagli admin dal pannello
    match /players/{playerId} {
      function validPlayer(d) {
        return d.keys().hasOnly(['name', 'team', 'teamId', 'role', 'number', 'birthYear', 'nationality', 'photo', 'active', 'updatedAt'])
          && isString(d.name, 80)
          && isString(d.team, 80)
          && d.role in ['P', 'S', 'C', 'O', 'L']
          && d.active is bool;
      }

      allow read: if signedIn();
      allow create, update: if isAdmin() && validPlayer(request.resource.data);
      allow delete: if false;
    }

    // Informazioni sugli aggiornamenti (ultimo listone applicato, ecc.)
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Giornate e statistiche: gestite dagli admin
    match /matchdays/{n} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /stats/{playerId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Codici invito: si legge un codice alla volta, nessun elenco
    match /leagueCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['leagueId'])
        && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.presidentUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.code == code;
      allow update, delete: if false;
    }

    match /leagues/{leagueId} {

      function validSettings(s) {
        return s.keys().hasOnly(['budget', 'mode', 'startMatchday', 'marketSuspended'])
          && (!('marketSuspended' in s) || s.marketSuspended is bool)
          && s.budget is number && s.budget >= 0 && s.budget <= 10000
          && s.mode in ['classifica', 'scontri']
          && s.startMatchday is int && s.startMatchday >= 1;
      }

      function validLeague(d) {
        return d.keys().hasOnly(['name', 'code', 'presidentUid', 'settings', 'createdAt'])
          && isString(d.name, 60)
          && d.code is string && d.code.matches('^[0-9]{6}$')
          && validSettings(d.settings)
          && d.createdAt is timestamp;
      }

      allow read: if isMember(leagueId) || isPresident(leagueId) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.presidentUid == request.auth.uid
        && validLeague(request.resource.data);
      // Il Presidente cambia nome e impostazioni, non codice, presidenza o data di creazione
      allow update: if isPresident(leagueId)
        && validLeague(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'settings']);
      allow delete: if false;

      match /members/{uid} {
        function validMember(d) {
          return d.keys().hasOnly(['teamName', 'code', 'joinedAt'])
            && isString(d.teamName, 40)
            && d.joinedAt is timestamp;
        }

        allow read: if isMember(leagueId) || isAdmin();
        // Si entra solo con il codice giusto, e solo per sé stessi; negli scontri diretti non più dopo il calendario
        allow create: if signedIn()
          && uid == request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.code == getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.code
          && !(getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.settings.mode == 'scontri'
               && exists(/databases/$(database)/documents/leagues/$(leagueId)/schedule/main));
        allow update: if signedIn()
          && uid == request.auth.uid
          && validMember(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName']);
        allow delete: if isPresident(leagueId) || (signedIn() && uid == request.auth.uid);
      }

      match /rosters/{uid} {
        // Durante l'asta la rosa si salva anche incompleta: al massimo 2 P, 4 S, 3 C, 2 O, 1 L
        function validRoster(d) {
          return d.keys().hasOnly(['P', 'S', 'C', 'O', 'L', 'all', 'prices', 'creditsLeft'])
            && d.P is list && d.P.size() <= 2
            && d.S is list && d.S.size() <= 4
            && d.C is list && d.C.size() <= 3
            && d.O is list && d.O.size() <= 2
            && d.L is list && d.L.size() <= 1
            && d.all is list && d.all.size() <= 12
            && d.all.toSet().size() == d.all.size()
            && d.all.toSet() == d.P.concat(d.S).concat(d.C).concat(d.O).concat(d.L).toSet()
            && d.prices is map && d.prices.keys().toSet() == d.all.toSet()
            && d.creditsLeft is number && d.creditsLeft >= 0;
        }

        allow read: if isMember(leagueId) || isAdmin();
        allow create, update: if isPresident(leagueId)
          && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(uid))
          && validRoster(request.resource.data);
        allow delete: if isPresident(leagueId);
      }

      match /lineups/{lineupId} {
        function roster(uid) {
          return get(/databases/$(database)/documents/leagues/$(leagueId)/rosters/$(uid)).data;
        }

        function lockAt(matchday) {
          return get(/databases/$(database)/documents/matchdays/$(string(matchday))).data.lockAt;
        }

        function validLineup(d) {
          let s = d.starters;
          let r = roster(request.auth.uid);
          let starters = [s.P, s.S1, s.S2, s.C1, s.C2, s.O, s.L];
          return d.keys().hasOnly(['uid', 'matchday', 'starters', 'bench', 'captain'])
            && d.uid == request.auth.uid
            && d.matchday is int
            && lineupId == string(d.matchday) + '_' + request.auth.uid
            && s.keys().hasOnly(['P', 'S1', 'S2', 'C1', 'C2', 'O', 'L'])
            && s.keys().hasAll(['P', 'S1', 'S2', 'C1', 'C2', 'O', 'L'])
            && s.P in r.P
            && s.S1 in r.S && s.S2 in r.S
            && s.C1 in r.C && s.C2 in r.C
            && s.O in r.O
            && s.L in r.L
            && d.bench is list && d.bench.size() == 5
            && d.bench.hasOnly(r.all)
            && starters.concat(d.bench).toSet().size() == 12
            && d.captain in starters;
        }

        // La propria formazione sempre; quelle degli altri solo dopo la scadenza; gli admin per calcolare i punteggi
        allow read: if isAdmin() || (isMember(leagueId)
          && (resource.data.uid == request.auth.uid || request.time >= lockAt(resource.data.matchday)));
        allow create, update: if isMember(leagueId)
          && validLineup(request.resource.data)
          && request.time < lockAt(request.resource.data.matchday);
        allow delete: if false;
      }

      // Calendario degli scontri diretti: lo genera il Presidente prima della giornata di inizio,
      // oppure un admin (anche dopo, se il Presidente se ne è dimenticato)
      match /schedule/{docId} {
        function primaDellInizio() {
          let inizio = league(leagueId).settings.startMatchday;
          return request.time < get(/databases/$(database)/documents/matchdays/$(string(inizio))).data.lockAt;
        }

        allow read: if isMember(leagueId) || isAdmin();
        allow create, update: if docId == 'main'
          && request.resource.data.keys().hasOnly(['teams', 'rounds', 'createdAt', 'createdBy'])
          && request.resource.data.rounds is map
          && ((isPresident(leagueId) && primaDellInizio()) || isAdmin());
        allow delete: if false;
      }

      // --- Mercato (Modalità Leghe FantaLVF). Le assegnazioni le applica il Presidente con un clic ---

      function scadenza(numero) {
        return get(/databases/$(database)/documents/matchdays/$(string(numero))).data.lockAt;
      }

      function rosaDi(uid) {
        return get(/databases/$(database)/documents/leagues/$(leagueId)/rosters/$(uid)).data;
      }

      // Finestra per la giornata numero: dopo l'inizio della giornata prima, prima della sua scadenza,
      // mercato non sospeso dal Presidente (l'app apre il mercato solo a giornata precedente finita)
      function finestra(numero, fino) {
        return !league(leagueId).settings.get('marketSuspended', false)
          && request.time < fino
          && (numero == 1 || request.time >= scadenza(numero - 1));
      }

      // Offerte segrete per gli svincolati: nessuno legge quelle degli altri prima della chiusura
      match /markets/{n}/offers/{offerId} {
        function chiusuraOfferte() {
          return scadenza(int(n)) - duration.value(3, 'h');
        }

        function validOffer(d) {
          let rosa = rosaDi(d.uid);
          return d.keys().hasOnly(['uid', 'playerIn', 'playerOut', 'role', 'extra', 'status', 'createdAt', 'updatedAt'])
            && d.role in ['P', 'S', 'C', 'O', 'L']
            && d.extra is int && d.extra >= 0
            && d.playerOut in rosa[d.role]
            && !(d.playerIn in rosa.all);
        }

        allow read: if (signedIn() && resource.data.uid == request.auth.uid)
          || ((isPresident(leagueId) || isAdmin()) && request.time >= chiusuraOfferte());
        allow create: if isMember(leagueId)
          && request.resource.data.uid == request.auth.uid
          && offerId == request.auth.uid + '_' + request.resource.data.playerIn
          && request.resource.data.status == 'active'
          && validOffer(request.resource.data)
          && finestra(int(n), chiusuraOfferte());
        allow update: if (
            // chi ha fatto l'offerta la modifica, la ritira o la rifà finché le offerte sono aperte
            signedIn() && resource.data.uid == request.auth.uid && resource.data.status in ['active', 'withdrawn']
            && finestra(int(n), chiusuraOfferte())
            && ((request.resource.data.status == 'active'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerOut', 'extra', 'status', 'updatedAt'])
                 && validOffer(request.resource.data))
              || (request.resource.data.status == 'withdrawn'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])))
          ) || (
            // il Presidente segna l'esito dopo la chiusura
            isPresident(leagueId) && request.time >= chiusuraOfferte()
            && resource.data.status == 'active'
            && request.resource.data.status in ['won', 'lost']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'motivo'])
          );
        allow delete: if false;
      }

      // Scambi tra squadre: li vedono solo le due squadre (e Presidente e admin)
      match /trades/{tradeId} {
        function validTrade(d) {
          return d.keys().hasOnly(['from', 'to', 'give', 'take', 'role', 'extra', 'status', 'matchday', 'createdAt', 'updatedAt', 'counterOf'])
            && d.from != d.to
            && exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(d.to))
            && d.role in ['P', 'S', 'C', 'O', 'L']
            && d.give in rosaDi(d.from)[d.role]
            && d.take in rosaDi(d.to)[d.role]
            && d.extra is int && d.extra >= 0
            && d.matchday is int;
        }

        allow read: if isPresident(leagueId) || isAdmin()
          || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
        allow create: if isMember(leagueId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.status == 'proposed'
          && validTrade(request.resource.data)
          && finestra(request.resource.data.matchday, scadenza(request.resource.data.matchday));
        allow update: if (
            signedIn() && resource.data.from == request.auth.uid && resource.data.status == 'proposed'
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            // chi riceve accetta (a mercato aperto), rifiuta o rilancia
            signedIn() && resource.data.to == request.auth.uid && resource.data.status == 'proposed'
            && request.resource.data.status in ['accepted', 'refused', 'countered']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && (request.resource.data.status != 'accepted'
                || finestra(resource.data.matchday, scadenza(resource.data.matchday)))
          ) || (
            isPresident(leagueId) && resource.data.status == 'accepted'
            && request.resource.data.status in ['executed', 'void']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'motivo'])
          );
        allow delete: if false;
      }

      // Registro dei movimenti: visibile a tutta la lega, lo scrive il Presidente quando applica il mercato
      match /transfers/{transferId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow create: if isPresident(leagueId)
          && request.resource.data.keys().hasOnly(['tipo', 'uid', 'playerIn', 'playerOut', 'valore', 'extra', 'matchday', 'at'])
          && request.resource.data.tipo in ['svincolato', 'scambio']
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Punteggi e classifica: li calcolano gli admin a partire dai tabellini ufficiali
      match /scores/{scoreId} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isAdmin();
      }

      match /standings/{uid} {
        allow read: if isMember(leagueId) || isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
